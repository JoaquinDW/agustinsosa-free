TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Sender y template aprobado de Agustin Sosa (no son secretos).
TWILIO_WHATSAPP_FROM=whatsapp:+13527065042
TWILIO_CONTENT_SID=
TWILIO_CONTENT_SID_PROMO=
TWILIO_CONTENT_SID_PROMO_RANKING=
